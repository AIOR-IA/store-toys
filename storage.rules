rules_version = '2';

// FASE 0B — deny-by-default. Ningún path se abre todavía.
// products/, qr-vouchers/ y users/ se habilitan en sus fases
// (docs/architecture/mi-pimpollito-plan.md §10.4). Nunca "if true" en producción.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
