rules_version = '2';

// FASE 0B — deny-by-default. Ninguna colección se abre todavía.
// Users/Products/Sales se habilitan colección por colección en sus fases
// (docs/architecture/mi-pimpollito-plan.md §10.2), nunca todas a la vez.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
